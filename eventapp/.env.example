# Copiar a .env.local:  cp .env.example .env.local

# Admin (servidor / seed): ruta al JSON de Firebase → Cuentas de servicio → Generar clave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./tu-proyecto-firebase-adminsdk-xxxxx.json

# Cliente web: mismo proyecto — Configuración del proyecto → app web → firebaseConfig
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# El flujo legado de fotos usa el backend (Cloudinary se configura en Render).
NEXT_PUBLIC_BACKEND_URL=https://weddingapp-c6ix.onrender.com

# Galería de invitaciones personalizadas: preset unsigned de Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opción sin JSON (p. ej. Vercel): descomenta y rellena
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
